{
  "name": "context-vault",
  "version": "1.0.0",
  "description": "Context Vault — your memory, on demand. Records screen + voice, makes it searchable, and lets you ask Claude about it.",
  "main": "./out/main/index.js",
  "author": "Context Vault",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-electron.cjs && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "node scripts/ensure-electron.cjs && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "mcp": "tsx mcp/server.mts"
  },
